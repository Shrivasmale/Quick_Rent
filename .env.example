# QuickRent Root Environment Configuration (Template)
# Never commit real .env files to source control!

# Public Frontend Variables (Safe for client browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key_here

# Backend Edge Function Secrets (Set via `supabase secrets set` - NEVER in frontend)
SUPABASE_SERVICE_ROLE_KEY=your_private_service_role_key
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
ALLOWED_ORIGINS=https://quickrent.com,http://localhost:5173
